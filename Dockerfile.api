FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY backend ./backend
COPY scripts ./scripts

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3001

EXPOSE 3001

CMD ["node", "--experimental-strip-types", "--experimental-transform-types", "--loader", "./scripts/ts-extension-loader.mjs", "./scripts/dev-api.ts"]
