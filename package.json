{
  "name": "khujandi-mini-app",
  "private": true,
  "prisma": {
    "schema": "backend/prisma/schema.prisma"
  },
  "scripts": {
    "dev:api": "node --experimental-strip-types --experimental-transform-types --loader ./scripts/ts-extension-loader.mjs ./scripts/dev-api.ts",
    "dev:frontend": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build:frontend": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:catalog": "jest --config jest.config.cjs tests/slices/catalog frontend/src/tests/slices/catalog",
    "test:catalog:unit": "jest --config jest.config.cjs tests/slices/catalog/catalog.unit.spec.ts",
    "test:catalog:integration": "jest --config jest.config.cjs tests/slices/catalog/catalog.integration.spec.ts",
    "test:catalog:runtime": "jest --config jest.config.cjs tests/slices/catalog/catalog.runtime.integration.spec.ts",
    "test:delivery-assignment": "jest --config jest.config.cjs tests/slices/delivery-assignment",
    "test:delivery-assignment:frontend": "jest --config jest.config.cjs frontend/src/tests/admin/admin-assignment-api.spec.ts frontend/src/tests/admin/admin-assignment-route.spec.tsx frontend/src/tests/admin/admin-assignment-view-model.spec.ts",
    "test:delivery-assignment:unit": "jest --config jest.config.cjs tests/slices/delivery-assignment/delivery-assignment.unit.spec.ts",
    "test:delivery-assignment:integration": "jest --config jest.config.cjs tests/slices/delivery-assignment/delivery-assignment.integration.spec.ts",
    "test:delivery-tracking": "jest --config jest.config.cjs tests/slices/delivery-tracking",
    "test:reviews-feedback": "jest --config jest.config.cjs tests/slices/reviews-feedback",
    "test:reviews-feedback:unit": "jest --config jest.config.cjs tests/slices/reviews-feedback/reviews-feedback.unit.spec.ts",
    "test:reviews-feedback:integration": "jest --config jest.config.cjs tests/slices/reviews-feedback/reviews-feedback.integration.spec.ts",
    "test:admin-access": "jest --config jest.config.cjs tests/slices/admin-access",
    "test:admin-access:unit": "jest --config jest.config.cjs tests/slices/admin-access/admin-access.unit.spec.ts",
    "test:admin-access:integration": "jest --config jest.config.cjs tests/slices/admin-access/admin-access.integration.spec.ts tests/slices/admin-access/admin-auth-http.integration.spec.ts",
    "test:order-cancellation": "jest --config jest.config.cjs tests/slices/order-cancellation",
    "test:order-cancellation:unit": "jest --config jest.config.cjs tests/slices/order-cancellation/order-cancellation.unit.spec.ts",
    "test:order-cancellation:integration": "jest --config jest.config.cjs tests/slices/order-cancellation/order-cancellation.integration.spec.ts",
    "test:order-tracking:frontend": "jest --config jest.config.cjs frontend/src/tests/slices/order-tracking",
    "test:delivery-tracking:unit": "jest --config jest.config.cjs tests/slices/delivery-tracking/delivery-tracking.unit.spec.ts",
    "test:delivery-tracking:integration": "jest --config jest.config.cjs tests/slices/delivery-tracking/delivery-tracking.integration.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jest": "^29.7.0",
    "playwright": "^1.60.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.1.10"
  },
  "dependencies": {
    "prisma": "^6.19.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-test-renderer": "^19.2.4"
  }
}
