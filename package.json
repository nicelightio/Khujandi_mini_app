    "test:catalog:integration": "jest --config jest.config.cjs tests/slices/catalog/catalog.integration.spec.ts",
    "test:delivery-assignment": "jest --config jest.config.cjs tests/slices/delivery-assignment",
    "test:delivery-assignment:frontend": "jest --config jest.config.cjs frontend/src/tests/admin",
    "test:delivery-assignment:unit": "jest --config jest.config.cjs tests/slices/delivery-assignment/delivery-assignment.unit.spec.ts",
    "test:delivery-assignment:integration": "jest --config jest.config.cjs tests/slices/delivery-assignment/delivery-assignment.integration.spec.ts",
    "test:delivery-tracking": "jest --config jest.config.cjs tests/slices/delivery-tracking",
    "test:order-tracking:frontend": "jest --config jest.config.cjs frontend/src/tests/slices/order-tracking",
    "test:delivery-tracking:unit": "jest --config jest.config.cjs tests/slices/delivery-tracking/delivery-tracking.unit.spec.ts",
