generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id                          String    @id @default(cuid())
  sellerId                    String
  name                        String
  renameCount                 Int       @default(0)
  requiresManualRenameReview  Boolean   @default(false)
  isDeleted                   Boolean   @default(false)
  deletedAt                   DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  products                    Product[]

  @@index([sellerId])
  @@index([isDeleted])
}

model Product {
  id         String    @id @default(cuid())
  shopId     String
  name       String
  priceMinor Int
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  shop       Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([isDeleted])
}
