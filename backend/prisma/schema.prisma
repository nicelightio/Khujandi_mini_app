generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  CREATED
  ASSIGNED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED_BY_ADMIN
  CANCELLED_BY_COURIER_UNAVAILABLE
}

enum PaymentStatus {
  PAID
  FAILED
  CANCELED
  PENDING
}

enum RefundStatus {
  NOT_REQUIRED
  PENDING_MANUAL
  DONE
  REJECTED
}

enum ShopStatus {
  WORKING
  NOT_WORKING
}

enum UserRole {
  BOSS
  MANAGER
  ADMIN
  SELLER
  COURIER
  CLIENT
}

enum AdminAuthAuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOCKED
  LOGOUT
}

enum ReviewTargetRole {
  CLIENT
  COURIER
}

enum ReviewSource {
  MINI_APP
  TELEGRAM_BOT
}

model Shop {
  id                          String    @id @default(cuid())
  sellerId                    String
  name                        String
  description                 String?
  headerImageUrl              String?
  backgroundImageUrl          String?
  status                      ShopStatus @default(WORKING)
  renameCount                 Int       @default(0)
  requiresManualRenameReview  Boolean   @default(false)
  isDeleted                   Boolean   @default(false)
  deletedAt                   DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  menuPages                   MenuPage[]
  products                    Product[]
  sellerBindings              SellerShopBinding[]

  @@index([sellerId])
  @@index([status])
  @@index([isDeleted])
  @@unique([sellerId, name])
}

model MenuPage {
  id        String    @id @default(cuid())
  shopId     String
  name      String
  position  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  shop      Shop      @relation(fields: [shopId], references: [id])
  products  Product[]

  @@index([shopId, position])
}

model Product {
  id         String    @id @default(cuid())
  shopId     String
  menuPageId String?
  name       String
  description String?
  imageUrl   String?
  priceMinor Int
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  shop       Shop      @relation(fields: [shopId], references: [id])
  menuPage   MenuPage? @relation(fields: [menuPageId], references: [id])

  @@index([shopId])
  @@index([menuPageId])
  @@index([isDeleted])
}

model SellerShopBinding {
  id         String   @id @default(cuid())
  shopId      String   @unique
  sellerId    String
  telegramId  String
  createdAt  DateTime @default(now())
  shop       Shop     @relation(fields: [shopId], references: [id])

  @@index([sellerId])
  @@index([telegramId])
}

model Order {
  id                     String       @id @default(cuid())
  shopId                 String
  shopNameSnapshot       String
  sellerId               String
  clientId               String
  courierId              String?
  status                 OrderStatus  @default(CREATED)
  itemsTotalMinor        Int
  deliveryFeeMinor       Int
  totalAmountMinor       Int
  paymentProvider        String
  paymentProviderTxId    String       @unique
  telegramPaymentChargeId String?     @unique
  providerPaymentChargeId String?     @unique
  paymentStatus          PaymentStatus @default(PAID)
  refundStatus           RefundStatus  @default(NOT_REQUIRED)
  refundNote             String?
  cancelledByUserId      String?
  cancellationReasonCode String?
  cancelledAt            DateTime?
  isDeleted              Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  shop                   Shop          @relation(fields: [shopId], references: [id])
  statusHistory          OrderStatusHistory[]
  assignmentAudits       DeliveryAssignmentAudit[]
  cancellationAudits     OrderCancellationAudit[]
  reviews                Review[]

  @@index([clientId, createdAt(sort: Desc)])
  @@index([courierId, status, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([isDeleted])
}

model OrderStatusHistory {
  id              BigInt      @id @default(autoincrement())
  orderId         String
  oldStatus       OrderStatus
  newStatus       OrderStatus
  changedByUserId String
  changedAt       DateTime    @default(now())
  order           Order       @relation(fields: [orderId], references: [id])

  @@index([orderId, changedAt])
}

model DeliveryAssignmentAudit {
  id            BigInt   @id @default(autoincrement())
  orderId       String
  adminUserId   String
  courierUserId String
  action        String
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@index([adminUserId, createdAt])
}

model OrderCancellationAudit {
  id            BigInt       @id @default(autoincrement())
  orderId       String
  actorUserId   String
  actorRole     UserRole
  action        String
  reasonCode    String?
  refundStatus  RefundStatus
  refundNote    String?
  fromStatus    OrderStatus?
  toStatus      OrderStatus?
  createdAt     DateTime     @default(now())
  order         Order        @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@index([actorUserId, createdAt])
}

model Event {
  id        BigInt   @id @default(autoincrement())
  type      String
  entity    String
  entityId  String
  payload   Json
  createdAt DateTime @default(now())

  @@index([entity, entityId, id])
}

model User {
  id              String           @id @default(cuid())
  telegramId      String           @unique
  role            UserRole         @default(CLIENT)
  name            String
  username        String?
  language        String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  miniAppSessions MiniAppSession[]
  authoredReviews Review[]         @relation("ReviewAuthor")
  targetedReviews Review[]         @relation("ReviewTarget")
}

model Review {
  id           BigInt           @id @default(autoincrement())
  orderId      String
  authorId     String
  targetUserId String
  targetRole   ReviewTargetRole
  rating       Int
  reasonCode   String
  comment      String?
  source       ReviewSource
  createdAt    DateTime         @default(now())
  order        Order            @relation(fields: [orderId], references: [id])
  author       User             @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetUser   User             @relation("ReviewTarget", fields: [targetUserId], references: [id])

  @@unique([orderId, authorId, targetUserId])
  @@index([orderId, createdAt])
  @@index([targetUserId, createdAt])
}

model ReviewDraft {
  id                String           @id @default(cuid())
  orderId           String
  actorUserId       String
  direction         String
  actorTelegramId   String
  targetUserId      String
  targetRole        ReviewTargetRole
  expectedStage     String
  expectedRevision  String
  rating            Int?
  reasonCode        String?
  submittedReviewId String?
  submittedRevision String?
  submittedComment  String?
  submittedCreatedAt DateTime?
  expiresAt         DateTime
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([orderId, actorUserId, direction])
  @@index([actorUserId, expiresAt])
  @@index([expiresAt])
}

model MiniAppSession {
  id               String    @id @default(cuid())
  userId           String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}

model TelegramAuthReplay {
  id           String   @id @default(cuid())
  initDataHash String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model AdminAccount {
  id           String           @id @default(cuid())
  login        String           @unique
  passwordHash String
  role         UserRole
  isActive     Boolean          @default(true)
  lockedUntil  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     AdminSession[]
  authAudits   AdminAuthAudit[]

  @@index([role])
  @@index([lockedUntil])
}

model AdminSession {
  id                   String       @id @default(cuid())
  adminAccountId       String
  accessTokenHash      String
  refreshTokenHash     String       @unique
  accessTokenExpiresAt DateTime
  refreshTokenExpiresAt DateTime
  idleExpiresAt        DateTime
  lastActivityAt       DateTime     @default(now())
  revokedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  adminAccount         AdminAccount @relation(fields: [adminAccountId], references: [id])

  @@index([adminAccountId, refreshTokenExpiresAt])
  @@index([adminAccountId, idleExpiresAt])
}

model AdminAuthAudit {
  id             BigInt               @id @default(autoincrement())
  adminAccountId String
  action         AdminAuthAuditAction
  ipAddress      String?
  userAgent      String?
  traceId        String
  reason         String?
  createdAt      DateTime             @default(now())
  adminAccount   AdminAccount         @relation(fields: [adminAccountId], references: [id])

  @@index([adminAccountId, action, createdAt])
}
