# Database
DATABASE_URL=postgresql://tgmeal:CHANGE_ME_PASSWORD@localhost:5432/tgmeal?schema=public

# Runtime mode (production-safe defaults)
NODE_ENV=production
APP_ENV=production
PAYMENT_PROVIDER=
DEBUG=FALSE
E2E_TEST_MODE=FALSE
E2E_TEST_TOKEN=

# Staging/local/e2e mock checkout only, never production:
# APP_ENV=staging
# NODE_ENV=staging
# PAYMENT_PROVIDER=mock
# DEBUG=TRUE
# E2E_TEST_MODE=TRUE
# E2E_TEST_TOKEN=<secret-outside-docs>

# Deploy/Compose routing and runtime storage (production-safe defaults)
TGMEAL_HOST=tgmeal.natureonzoom.win
TRAEFIK_ROUTER_PREFIX=tgmeal
TGMEAL_RUNTIME_VOLUME=tgmeal_catalog_runtime_data
TGMEAL_RUNTIME_DIR=/var/lib/khujandi
ADMIN_DB_PATH=/var/lib/khujandi/admin-access-runtime.sqlite
CATALOG_DB_PATH=/var/lib/khujandi/catalog-runtime.sqlite
CHECKOUT_PAYMENT_DB_PATH=/var/lib/khujandi/checkout-payment-runtime.sqlite
OPERATIONAL_RUNTIME_DB_PATH=/var/lib/khujandi/operational-runtime.sqlite

# Server staging override example:
# TGMEAL_HOST=staging-tgmeal.natureonzoom.win
# TRAEFIK_ROUTER_PREFIX=tgmeal-staging
# TGMEAL_RUNTIME_VOLUME=tgmeal_staging_runtime_data
# TGMEAL_RUNTIME_DIR=/var/lib/khujandi-staging
# ADMIN_DB_PATH=/var/lib/khujandi-staging/admin-access-runtime.sqlite
# CATALOG_DB_PATH=/var/lib/khujandi-staging/catalog-runtime.sqlite
# CHECKOUT_PAYMENT_DB_PATH=/var/lib/khujandi-staging/checkout-payment-runtime.sqlite
# OPERATIONAL_RUNTIME_DB_PATH=/var/lib/khujandi-staging/operational-runtime.sqlite

# Admin (full URL of your production domain)
ADMIN_ALLOWED_ORIGINS=https://tgmeal.natureonzoom.win

# Optional: JWT secret for production (generate a random string)
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# Optional: Telegram Bot Token (if using bot features)
TELEGRAM_BOT_TOKEN=
