# Database
DATABASE_URL=postgresql://tgmeal:CHANGE_ME_PASSWORD@localhost:5432/tgmeal?schema=public

# Runtime mode (production-safe defaults)
NODE_ENV=production
PAYMENT_PROVIDER=
DEBUG=FALSE

# Test server mock checkout only, never production:
